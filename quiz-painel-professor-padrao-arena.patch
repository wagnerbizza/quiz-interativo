+  function montar() {
+    const nav = document.querySelector(".qi-shell > .qi-quick-links");
+    if (!nav || document.getElementById("qi-favoritos")) return;
+    const paginas = new Map();
+    document.querySelectorAll(".qi-shell .qi-menus [data-qi-page], .qi-shell .qi-quick-links [data-qi-page]").forEach(botao => {
+      if (!paginas.has(botao.dataset.qiPage)) paginas.set(botao.dataset.qiPage, botao.textContent.trim());
+    });
+    const favoritas = new Set(Array.isArray(pref.favoritas) ? pref.favoritas : ["ativacao", "monitoramento", "relatorios"]);
+    const favoritos = document.createElement("section");
+    favoritos.id = "qi-favoritos";
+    favoritos.className = "qi-card";

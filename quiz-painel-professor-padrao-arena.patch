+<script>
+(() => {
+  const chave = "quiz-professor-painel-v1";
+  let pref = {};
+  try { pref = JSON.parse(localStorage.getItem(chave)) || {}; } catch {}
+  const salvar = () => {
+    try { localStorage.setItem(chave, JSON.stringify(pref)); return true; } catch { return false; }

+    function renderizar() {
+      const botoes = favoritos.querySelector("[data-favoritos]");
+      botoes.replaceChildren();
+      for (const [id, nome] of paginas) {
+        if (!favoritas.has(id)) continue;
+        const b = document.createElement("button");
+        b.type = "button"; b.className = "qi-button"; b.dataset.qiPage = id; b.textContent = nome;
+        botoes.append(b);
+      }
+    }
+    for (const [id, nome] of paginas) {
+      if (id === "inicio") continue;
+      const label = document.createElement("label");
+      const caixa = document.createElement("input");
+      caixa.type = "checkbox"; caixa.checked = favoritas.has(id);
+      caixa.onchange = () => {
+        if (caixa.checked) favoritas.add(id); else favoritas.delete(id);
+        pref.favoritas = [...favoritas];
+        favoritos.querySelector("[role=status]").textContent = salvar() ? "" : "O navegador não conseguiu salvar os atalhos.";
+        renderizar();
+      };
+      label.append(caixa, nome);
+      favoritos.querySelector("fieldset").append(label);
+    }
+    renderizar();
+    const busca = document.querySelector('label[for="qi-function-search"]');
+    if (busca) busca.textContent = "Encontrar uma função";
+    const config = document.createElement("section");
+    config.id = "qi-config-professor";
+    config.className = "qi-card";
+    config.innerHTML = '<h2>Aparência do painel e dos documentos</h2><label>Cor do destaque das avaliações <input type="color"></label><label><input type="checkbox" data-menu-lateral> Menu lateral em telas largas</label><p>As preferências ficam neste navegador. Sem um logotipo específico, o documento usa o logotipo do sistema.</p><div data-logos></div><p role="status"></p>';
+    const aplicar = () => {
+      const cor = /^#[0-9a-f]{6}$/i.test(pref.cor) ? pref.cor : "#22c55e";
+      document.documentElement.style.setProperty("--qi-prova-cor", cor);
+      config.querySelector('input[type=color]').value = cor;
+      document.body.classList.toggle("qi-menu-lateral", pref.lateral !== false);
+    };
+    const persistir = () => {
+      config.querySelector('[role=status]').textContent = salvar() ? "Preferências salvas." : "O navegador não conseguiu salvar as preferências.";
+    };
+    config.querySelector('input[type=color]').oninput = e => { pref.cor = e.target.value; aplicar(); persistir(); };
+    const lateral = config.querySelector("[data-menu-lateral]");
+    lateral.checked = pref.lateral !== false;
+    lateral.onchange = () => { pref.lateral = lateral.checked; aplicar(); persistir(); };
+    for (const [tipo, nome] of [["relatorio","Relatórios e boletins"],["certificado","Certificados"],["prova","Cópias de prova"]]) {
+      const linha = document.createElement("div");
+      linha.innerHTML = '<label><input type="file" accept="image/png,image/jpeg,image/webp"></label><img alt="" hidden><button type="button" class="qi-button">Usar logo do sistema</button>';
+      linha.querySelector("label").prepend(nome + " ");
+      const img = linha.querySelector("img");
+      const arquivo = linha.querySelector("input");
+      function mostrar() {
+        const logo = window.logoDocumentoProfessorQuiz(tipo);
+        if (logo) img.src = logo; else img.removeAttribute("src");
+        img.hidden = !logo;
+        img.alt = "Prévia do logotipo — " + nome;
+      }
+      arquivo.onchange = () => {
+        const file = arquivo.files[0];
+        if (!file) return;
+        if (!["image/png","image/jpeg","image/webp"].includes(file.type) || file.size > 500000) {
+          config.querySelector('[role=status]').textContent = "Selecione PNG, JPG ou WebP de até 500 KB.";
+          arquivo.value = "";
+          return;
+        }
+        const leitor = new FileReader();
+        leitor.onload = () => {
+          if (!logoValido(leitor.result)) return;
+          pref.logos = {...pref.logos, [tipo]: leitor.result};
+          mostrar(); persistir();
+        };
+        leitor.onerror = () => { config.querySelector('[role=status]').textContent = "Não foi possível ler o logotipo."; };
+        leitor.readAsDataURL(file);
+      };
+      linha.querySelector("button").onclick = () => {
+        pref.logos = {...pref.logos, [tipo]: ""}; arquivo.value = ""; mostrar(); persistir();
+      };
+      mostrar();
+      config.querySelector("[data-logos]").append(linha);
+    }
+    const anexarConfig = () => {
+      const identidade = document.getElementById("qi-identidade");
+      if (identidade && !identidade.contains(config)) identidade.append(config);
+    };
+    new MutationObserver(anexarConfig).observe(document.querySelector(".container"), {childList:true, subtree:true});
+    anexarConfig();
+    aplicar();
+    const rolagem = document.createElement("nav");
+    rolagem.id = "qi-rolagem";
+    rolagem.setAttribute("aria-label","Rolagem da página");
+    for (const [icone, nome, destino] of [["↑","Ir ao topo",0],["↓","Ir ao final",1]]) {
+      const b = document.createElement("button");
+      b.type = "button"; b.className = "qi-button"; b.textContent = icone;
+      b.title = nome; b.setAttribute("aria-label",nome);
+      b.onclick = () => window.scrollTo({
+        top: destino ? document.scrollingElement.scrollHeight : 0,
+        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth"
+      });
+      rolagem.append(b);
+    }
+    document.body.append(rolagem);
+  }
+  if (document.readyState === "complete") montar();
+  else window.addEventListener("load", montar, {once:true});
+})();

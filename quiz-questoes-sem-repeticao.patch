+function selecionarQuestoesUnicas(questoes) {
+  const enunciados = new Set();
+  const identificadores = new Set();
+  return questoes.filter(questao => {
+    const enunciado = String(questao.pergunta || "").normalize("NFC").toLowerCase().replace(/\s+/g, " ").trim();
+    const id = questao.idQuestao || questao.idDoc || questao.id;
+    if (!enunciado || enunciados.has(enunciado) || (id && identificadores.has(id))) return false;
+    enunciados.add(enunciado);
+    if (id) identificadores.add(id);
+    return true;
+  });
+}

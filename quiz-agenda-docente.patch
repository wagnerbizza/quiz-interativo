 </script>
 
+<style>
+  #qi-agenda { margin-bottom: 1rem; }
+  #qi-agenda h2, #qi-agenda h3 { margin: 0 0 .6rem; }
+  #qi-agenda .agenda-acoes { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; }
+  #qi-agenda .agenda-campos { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr)); gap:.6rem; margin:.6rem 0; }
+  #qi-agenda .agenda-campos label { display:grid; gap:.25rem; min-width:0; }
+  #qi-agenda .agenda-campos input, #qi-agenda select { width:100%; min-width:0; }
+  #qi-agenda .agenda-itens { list-style:none; padding:0; }
+  #qi-agenda .agenda-itens li { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.5rem; align-items:center; padding:.6rem 0; border-bottom:1px solid var(--qi-line, #526276); overflow-wrap:anywhere; }
+  #qi-agenda details { margin-top:.8rem; }
+</style>
+<template id="qi-agenda-template">
+  <section class="qi-card" id="qi-agenda" aria-labelledby="qi-agenda-title">
+    <h2 id="qi-agenda-title">Agenda docente</h2>
+    <p class="qi-muted">Aulas, avisos e compromissos da semana. Os registros ficam neste navegador.</p>
+    <div class="agenda-acoes">
+      <button type="button" class="qi-button" data-week="-1" aria-label="Semana anterior">←</button>
+      <button type="button" class="qi-button" data-week="0">Semana atual</button>
+      <button type="button" class="qi-button" data-week="1" aria-label="Próxima semana">→</button>
+      <button type="button" class="qi-button" data-qi-page="ativacao">Avaliações ativas</button>
+    </div>
+    <h3 id="qi-agenda-periodo" aria-live="polite"></h3>
+    <label>Filtrar por escola <select id="qi-agenda-escola"><option value="">Todas as escolas</option></select></label>
+    <p id="qi-agenda-vazio">Nenhum item nesta semana.</p>
+    <ul class="agenda-itens" id="qi-agenda-itens"></ul>
+    <details id="qi-agenda-edicao">
+      <summary>Adicionar ou editar item</summary>
+      <form id="qi-agenda-form">
+        <div class="agenda-campos">
+          <label>Descrição <input name="titulo" maxlength="100" required></label>
+          <label>Escola <input name="escola" maxlength="100" placeholder="Deixe em branco para um item geral"></label>
+          <label>Tipo <select name="tipo"><option>Aula</option><option>Compromisso</option><option>Aviso</option><option>Dia letivo</option><option>Dia não letivo</option></select></label>
+          <label>Data inicial <input name="data" type="date" required></label>
+          <label>Horário <input name="hora" type="time"></label>
+          <label>Repetição <select name="repeticao"><option value="unica">Uma vez</option><option value="semanal">Toda semana</option></select></label>
+        </div>
+        <div class="agenda-acoes">
+          <button class="qi-button primary" type="submit">Salvar na agenda</button>
+          <button class="qi-button" type="reset">Limpar formulário</button>
+        </div>
+      </form>
+    </details>
+    <p id="qi-agenda-status" role="status"></p>
+    <details>
+      <summary>Manual rápido da agenda</summary>
+      <ol>
+        <li>Na Home, abra <strong>Adicionar ou editar item</strong>.</li>
+        <li>Informe a escola, o tipo e a data. Use <strong>Toda semana</strong> para repetir uma aula a partir da data inicial.</li>
+        <li>Use as setas para mudar de semana e o filtro para consultar uma escola. Use <strong>Editar</strong> ou <strong>Excluir</strong> na linha do item para alterar a série inteira.</li>
+        <li>Use <strong>Avaliações ativas</strong> para abrir a área de ativação e conferir o estado real das provas.</li>
+      </ol>
+    </details>
+  </section>
+</template>
+<script>
+(() => {
+  const storageKey = "quiz.agendaDocente.v1";
+  const weekdays = new Intl.DateTimeFormat("pt-BR", {weekday:"short", day:"2-digit", month:"2-digit", timeZone:"UTC"});
+  const shortDate = new Intl.DateTimeFormat("pt-BR", {day:"2-digit", month:"2-digit", year:"numeric", timeZone:"UTC"});
+  const toISO = date => date.toISOString().slice(0,10);
+  const parseDay = day => new Date(day + "T00:00:00Z");
+  const addDays = (date, days) => new Date(date.getTime() + days * 86400000);
+  function today() {
+    const now = new Date();
+    return new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()));
+  }
+  function monday(date) {
+    return addDays(date, -((date.getUTCDay() + 6) % 7));
+  }
+  function mount() {
+    const home = document.getElementById("qi-inicio");
+    if (!home || document.getElementById("qi-agenda")) return;
+    home.prepend(document.getElementById("qi-agenda-template").content.cloneNode(true));
+    const agenda = document.getElementById("qi-agenda");
+    const form = agenda.querySelector("form");
+    const filter = agenda.querySelector("#qi-agenda-escola");
+    const status = agenda.querySelector("#qi-agenda-status");
+    const list = agenda.querySelector("#qi-agenda-itens");
+    let entries = [];
+    let week = monday(today());
+    let editing = null;
+    let readable = true;
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey) || "[]");
+      if (!Array.isArray(saved)) throw new Error("Agenda inválida");
+      entries = saved;
+    } catch {
+      readable = false;
+      status.textContent = "Não foi possível ler a agenda deste navegador.";
+    }
+    form.elements.data.value = toISO(today());
+
+    function render() {
+      const selected = filter.value;
+      filter.replaceChildren(new Option("Todas as escolas", ""));
+      const schools = [...new Set(entries.map(item => item.escola).filter(Boolean))].sort((a,b) => a.localeCompare(b,"pt-BR"));
+      schools.forEach(school => filter.add(new Option(school, school)));
+      filter.value = schools.includes(selected) ? selected : "";
+      agenda.querySelector("#qi-agenda-periodo").textContent =
+        shortDate.format(week) + " a " + shortDate.format(addDays(week, 6));
+      list.replaceChildren();
+      for (let index = 0; index < 7; index++) {
+        const day = addDays(week, index);
+        const iso = toISO(day);
+        const matches = entries.filter(item => {
+          if (filter.value && item.escola !== filter.value) return false;
+          if (item.data === iso) return true;
+          return item.repeticao === "semanal" && item.data < iso &&
+            parseDay(item.data).getUTCDay() === day.getUTCDay();
+        }).sort((a,b) => (a.hora || "").localeCompare(b.hora || ""));
+        for (const item of matches) {
+          const row = document.createElement("li");
+          const label = document.createElement("span");
+          label.textContent = [weekdays.format(day), item.hora, item.tipo, item.titulo, item.escola || "Geral"].filter(Boolean).join(" · ");
+          const actions = document.createElement("div");
+          actions.className = "agenda-acoes";
+          for (const [action, text] of [["edit","Editar"],["remove","Excluir"]]) {
+            const button = document.createElement("button");
+            button.type = "button";
+            button.className = "qi-button";
+            button.dataset.agendaAction = action;
+            button.dataset.agendaId = item.id;
+            button.textContent = text;
+            button.setAttribute("aria-label", text + " " + item.titulo);
+            actions.append(button);
+          }
+          row.append(label, actions);
+          list.append(row);
+        }
+      }
+      agenda.querySelector("#qi-agenda-vazio").hidden = list.children.length > 0;
+    }
+
+    function persist(next, message) {
+      if (!readable) return false;
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(next));
+      } catch {
+        status.textContent = "Não foi possível gravar a agenda neste navegador.";
+        return false;
+      }
+      entries = next;
+      status.textContent = message;
+      render();
+      return true;
+    }
+
+    agenda.addEventListener("click", event => {
+      const weekButton = event.target.closest("[data-week]");
+      if (weekButton) {
+        const delta = Number(weekButton.dataset.week);
+        week = delta ? addDays(week, delta * 7) : monday(today());
+        render();
+      }
+      const button = event.target.closest("[data-agenda-action]");
+      if (!button) return;
+      const item = entries.find(entry => entry.id === button.dataset.agendaId);
+      if (!item) return;
+      if (button.dataset.agendaAction === "edit") {
+        editing = item.id;
+        for (const name of ["titulo","escola","tipo","data","hora","repeticao"]) form.elements[name].value = item[name];
+        agenda.querySelector("#qi-agenda-edicao").open = true;
+        form.elements.titulo.focus();
+      } else if (confirm("Excluir este item da agenda? Isso também remove suas repetições.")) {
+        if (persist(entries.filter(entry => entry.id !== item.id), "Item excluído.") && editing === item.id) form.reset();
+      }
+    });
+    filter.addEventListener("change", render);
+    form.addEventListener("reset", () => {
+      editing = null;
+      queueMicrotask(() => { form.elements.data.value = toISO(today()); });
+    });
+    form.addEventListener("submit", event => {
+      event.preventDefault();
+      const values = Object.fromEntries(new FormData(form));
+      values.titulo = values.titulo.trim();
+      values.escola = values.escola.trim();
+      if (!values.titulo) {
+        status.textContent = "Informe a descrição do item.";
+        form.elements.titulo.focus();
+        return;
+      }
+      const item = { ...values, id: editing || crypto.randomUUID() };
+      const next = editing ? entries.map(entry => entry.id === editing ? item : entry) : [...entries, item];
+      const previousWeek = week;
+      const previousFilter = filter.value;
+      week = monday(parseDay(item.data));
+      filter.value = "";
+      if (persist(next, "Item salvo nesta agenda.")) {
+        form.reset();
+        agenda.querySelector("#qi-agenda-edicao").open = false;
+      } else {
+        week = previousWeek;
+        filter.value = previousFilter;
+      }
+    });
+    render();
+  }
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", () => setTimeout(mount, 0), {once:true});
+  else mount();
+})();
+</script>
 </body>
 </html>

+function mostrarConfirmacaoCentral({ titulo, mensagem, acao, tom = "sucesso" }) {
+  const aviso = document.createElement("dialog");
+  aviso.className = "qi-card";
+  aviso.setAttribute("aria-label", titulo);
+  const cor = tom === "atencao" ? "#fbbf24" : "#22c55e";
+  aviso.style.cssText = "width:min(32rem,calc(100% - 2rem));box-sizing:border-box;padding:1.25rem;border-top:4px solid " + cor;
+  const simbolo = document.createElement("span");
+  simbolo.setAttribute("aria-hidden", "true");
+  simbolo.textContent = tom === "atencao" ? "!" : "✓";
+  simbolo.style.cssText = "display:inline-grid;place-items:center;width:2.4rem;height:2.4rem;border-radius:50%;font-size:1.25rem;font-weight:700;color:#111827;background:" + cor;
+  const cabecalho = document.createElement("h2");
+  cabecalho.textContent = titulo;
+  const texto = document.createElement("p");
+  texto.textContent = mensagem;
+  texto.style.whiteSpace = "pre-line";
+  const botoes = document.createElement("div");
+  botoes.className = "qi-actions";
+  const fechar = document.createElement("button");
+  fechar.type = "button";
+  fechar.className = "qi-button";
+  fechar.textContent = "Fechar";
+  fechar.autofocus = true;
+  fechar.onclick = () => aviso.close();
+  botoes.append(fechar);
+  if (acao) {
+    const abrir = document.createElement("button");
+    abrir.type = "button";
+    abrir.className = "qi-button primary";
+    abrir.textContent = acao.rotulo;
+    abrir.onclick = () => {
+      aviso.close();
+      acao.executar();
+    };
+    botoes.append(abrir);
+  }
+  aviso.append(simbolo, cabecalho, texto, botoes);
+  document.body.append(aviso);
+  aviso.addEventListener("close", () => aviso.remove(), { once: true });
+  aviso.showModal();
+  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
+      document.documentElement.dataset.qiMotion !== "true") {
+    aviso.animate?.([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "translateY(0)" }],
+      { duration: 180, easing: "ease-out" });
+  }
+}

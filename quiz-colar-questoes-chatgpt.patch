+        function converterQuestoesColadas(texto, materia) {
+          // A revisão existente continua aceitando arquivos JSON e linhas com separadores.
+          if (/^[\[{]/.test(texto) || texto.includes("|")) return texto;
+          const questoes = [];
+          let atual;
+          let campo = -1;
+          for (const bruta of texto.split(/\r?\n/)) {
+            const linha = bruta.trim().replace(/\*\*/g, "");
+            if (!linha || /^-{3,}$/.test(linha)) continue;
+            const questao = linha.match(/^(?:quest[ãa]o\s+)?\d+(?:[.):–-]\s*|\s+)(.*)$/i);
+            const opcao = linha.match(/^([A-E])[).:\-]\s*(.*)$/i);
+            const gabarito = linha.match(/^(?:gabarito|resposta correta|alternativa correta)\s*:\s*([A-E])\b/i);
+            if (questao) {
+              atual = {materia, pergunta:questao[1], opcoes:Array(5).fill(""), correta:""};
+              questoes.push(atual);
+              campo = -1;
+            } else if (atual && opcao) {
+              campo = "ABCDE".indexOf(opcao[1].toUpperCase());
+              if (atual.opcoes[campo]) throw Error("Há uma letra repetida na questão " + questoes.length + ".");
+              atual.opcoes[campo] = opcao[2];
+            } else if (atual && gabarito) {
+              if (atual.correta) throw Error("Há mais de um gabarito na questão " + questoes.length + ".");
+              atual.correta = gabarito[1].toUpperCase();
+              campo = -2;
+            } else if (atual && campo === -1) {
+              atual.pergunta = (atual.pergunta + " " + linha).trim();
+            } else if (atual && campo >= 0) {
+              atual.opcoes[campo] = (atual.opcoes[campo] + " " + linha).trim();
+            } else {
+              throw Error("Cole somente as questões numeradas, com alternativas A) a E) e Gabarito: B em cada questão.");
+            }
+          }
+          if (!questoes.length) throw Error("Nenhuma questão numerada foi encontrada.");
+          return JSON.stringify({questoes});
+        }

+.quiz-home-weather form{display:flex;align-items:end;flex-wrap:wrap;gap:8px}.quiz-home-weather label{flex:1;min-width:min(180px,100%);font-size:14px}.quiz-home-weather input{width:100%;min-width:0}.quiz-home-weather button{min-height:42px}.quiz-home-weather small{font-size:12px;color:var(--muted)}

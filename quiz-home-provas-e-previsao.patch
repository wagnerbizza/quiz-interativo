+<style>
+  #qi-home-resumo { margin-bottom:16px; }
+  #qi-home-resumo .qi-home-prova { padding:10px 0; border-bottom:1px solid var(--qi-line); overflow-wrap:anywhere; }
+  #qi-home-resumo .qi-home-prova p { margin:4px 0; }
+  #qi-home-clima { --line:var(--qi-line); --panel:var(--qi-panel); --muted:var(--qi-muted); --accent:var(--qi-accent); }
+.quiz-home-weather{margin:0 0 16px;padding:12px 16px;border:1px solid var(--line);border-radius:12px;background:var(--panel);font-size:14px;min-width:0}
+.quiz-home-weather>summary{cursor:pointer;display:flex;align-items:center;flex-wrap:wrap;gap:6px 14px;list-style:revert;min-height:30px}
+.quiz-home-weather>summary strong{font-size:14px}.quiz-home-weather>summary span{color:var(--muted);font-size:13px}
+.quiz-home-weather-body{margin-top:14px;display:grid;gap:12px}.quiz-home-weather-body p{margin:0;line-height:1.5}

+.quiz-home-weather[aria-busy="true"] [data-weather-refresh]{opacity:.65}
+.quiz-home-weather a{color:var(--accent);text-decoration:underline}.quiz-home-weather [data-weather-status]{font-size:13px;color:var(--muted)}
+@media(max-width:480px){.quiz-home-weather-days{grid-template-columns:1fr}.quiz-home-weather-days article{grid-template-columns:1fr 1fr}.quiz-home-weather-days article strong{grid-column:1/-1}}
+@media print{.quiz-home-weather{display:none!important}}
+</style>
+<template id="qi-home-resumo-template">
+  <section id="qi-home-resumo" class="qi-card no-print" aria-labelledby="qi-home-provas-titulo">
+    <h2 id="qi-home-provas-titulo">Avaliações ativas</h2>
+    <p role="status" data-provas-status>Aguardando consulta…</p>
+    <ul data-provas-lista></ul>
+    <div class="qi-actions">
+      <button type="button" class="qi-button" data-provas-atualizar>Atualizar lista</button>
+      <button type="button" class="qi-button" data-qi-page="ativacao">Abrir ativação de provas</button>
+    </div>
+  </section>
+  <div id="qi-home-clima" class="no-print"></div>
+</template>
+<script type="module">
+function montarResumoHome() {
+  const home = document.getElementById("qi-inicio");
+  if (!home || document.getElementById("qi-home-resumo")) return false;
+  home.prepend(document.getElementById("qi-home-resumo-template").content.cloneNode(true));
+  const painel = document.getElementById("qi-home-resumo");
+  const status = painel.querySelector("[data-provas-status]");
+  const lista = painel.querySelector("[data-provas-lista]");
+  const atualizar = painel.querySelector("[data-provas-atualizar]");
+  let carregando = false;
+
+  async function consultarFirebase() {
+    const sdk = "https://www.gstatic.com/firebasejs/10.8.0/";
+    const [{getApp}, {getFirestore, collection, getDocsFromServer, query, where}] = await Promise.all([
+      import(sdk + "firebase-app.js"), import(sdk + "firebase-firestore.js")
+    ]);
+    const db = getFirestore(getApp());
+    const snapshot = await getDocsFromServer(query(collection(db, "provas_ativas"), where("ativa", "==", true)));
+    return snapshot.docs.map(doc => doc.data());
+  }
+
+  async function consultarArquivo() {
+    const resposta = await fetch("prova-publicada.json", {cache:"no-store", signal:AbortSignal.timeout(8000)});
+    if (!resposta.ok) throw new Error("Pacote indisponível");
+    return resposta.json();
+  }
+
+  async function carregar() {
+    if (carregando || home.hidden) return;
+    carregando = true;
+    atualizar.disabled = true;
+    status.textContent = "Consultando avaliações…";
+    try {
+      const [firebase, arquivo] = await Promise.allSettled([consultarFirebase(), consultarArquivo()]);
+      const provas = new Map();
+      const chave = nome => String(nome || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim().toLowerCase();
+      const adicionar = prova => {
+        if (prova?.ativa === true && chave(prova.escolaAtiva)) provas.set(chave(prova.escolaAtiva), prova);
+      };
+      if (firebase.status === "fulfilled") firebase.value.forEach(adicionar);
+      if (arquivo.status === "fulfilled") adicionar(arquivo.value);
+      lista.replaceChildren();
+      const agora = Date.now();
+      for (const prova of [...provas.values()].sort((a,b) => a.escolaAtiva.localeCompare(b.escolaAtiva,"pt-BR"))) {
+        const item = document.createElement("li");
+        item.className = "qi-home-prova";
+        const escola = document.createElement("strong");
+        escola.textContent = prova.escolaAtiva;
+        const detalhes = document.createElement("p");
+        const turmas = Array.isArray(prova.turmasAtivas) ? prova.turmasAtivas.join(", ") : "";
+        const prazo = Number(prova.expiraEmMillis);
+        const inicio = Number(prova.agendamento);
+        const situacao = prazo > 0 && agora >= prazo ? "Prazo de entrada encerrado" :
+          inicio > agora ? "Início agendado" : "Entradas liberadas";
+        detalhes.textContent = [prova.tipoAtividade, turmas && "Turmas: " + turmas, situacao].filter(Boolean).join(" · ");
+        item.append(escola, detalhes);
+        lista.append(item);
+      }
+      const parcial = firebase.status !== "fulfilled" || arquivo.status !== "fulfilled";
+      status.textContent = provas.size ? provas.size + (provas.size === 1 ? " escola com avaliação ativa." : " escolas com avaliações ativas.") :
+        parcial ? "Não foi possível confirmar se há avaliações ativas." : "Nenhuma avaliação ativa.";
+      if (parcial && provas.size) status.textContent += " Uma das fontes está indisponível.";
+    } finally {
+      carregando = false;
+      atualizar.disabled = false;
+    }
+  }
+  atualizar.addEventListener("click", carregar);
+  new MutationObserver(() => { if (!home.hidden) carregar(); }).observe(home, {attributes:true, attributeFilter:["hidden"]});
+  carregar();
+/* Previsão Open-Meteo. Cache local; independente do Firebase e dos placares. */
+(function(){
+ 'use strict';
+ if(document.getElementById('quizHomeWeather'))return;
+ const TTL=30*60*1000,defaultPlace={name:'São Paulo, SP',latitude:-23.55,longitude:-46.63};
+ const storage={read(key){try{return JSON.parse(localStorage.getItem(key));}catch{return null;}},write(key,value){try{localStorage.setItem(key,JSON.stringify(value));}catch{}}};
+ const validPlace=p=>p&&typeof p.name==='string'&&p.name.length<=180&&Number.isFinite(p.latitude)&&Math.abs(p.latitude)<=90&&Number.isFinite(p.longitude)&&Math.abs(p.longitude)<=180;
+ let place=storage.read('quiz-home-weather-place-v1');if(!validPlace(place))place=defaultPlace;
+ let sequence=0,loading=false,lastAttempt=0,searchSequence=0;
+ const main=document.getElementById('qi-home-clima');if(!main)return;
+ const panel=document.createElement('details');panel.id='quizHomeWeather';panel.className='quiz-home-weather no-print';panel.setAttribute('aria-label','Previsão do tempo');
+ panel.innerHTML='<summary><strong data-weather-title>Previsão do tempo</strong><span data-weather-summary>Consultando previsão…</span></summary><div class="quiz-home-weather-body"><p data-weather-status role="status" aria-live="polite"></p><div class="quiz-home-weather-days" data-weather-days></div><div class="toolbar"><button type="button" data-weather-refresh>Atualizar previsão</button></div><form data-weather-search><label>Cidade<input name="city" type="search" minlength="3" maxlength="100" placeholder="Ex.: São Paulo" required autocomplete="off"></label><button type="submit">Buscar cidade</button></form><div class="quiz-home-weather-results" data-weather-results></div><small>A cidade escolhida vale neste navegador. A previsão pode mudar. Fonte: <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a>.</small></div>';
+ main.prepend(panel);const find=s=>panel.querySelector(s),status=text=>{find('[data-weather-status]').textContent=text;};
+ function label(code){if(code===0)return 'Céu limpo';if([1,2,3].includes(code))return 'Parcialmente nublado a nublado';if([45,48].includes(code))return 'Nevoeiro';if([51,53,55,56,57].includes(code))return 'Garoa';if([61,63,65,66,67,80,81,82].includes(code))return 'Chuva';if([71,73,75,77,85,86].includes(code))return 'Neve';if([95,96,99].includes(code))return 'Trovoadas';return 'Condição não informada';}
+ const finite=x=>typeof x==='number'&&Number.isFinite(x),number=x=>finite(x)?Math.round(x).toLocaleString('pt-BR'):'—';
+ function usable(data){return data&&data.current&&finite(data.current.temperature_2m)&&typeof data.current.time==='string'&&data.daily&&Array.isArray(data.daily.time)&&data.daily.time.length>0&&Array.isArray(data.daily.temperature_2m_min)&&Array.isArray(data.daily.temperature_2m_max)&&Array.isArray(data.daily.precipitation_probability_max);}
+ function paint(data,at,stale){
+  if(!usable(data))return false;
+  find('[data-weather-title]').textContent=place.name+' · '+number(data.current.temperature_2m)+' °C';
+  find('[data-weather-summary]').textContent=label(data.current.weather_code)+' · '+(stale?'dados salvos':'previsão de 3 dias');
+  const days=find('[data-weather-days]');days.replaceChildren();
+  data.daily.time.slice(0,3).forEach((day,i)=>{if(!/^\d{4}-\d{2}-\d{2}$/.test(day))return;const article=document.createElement('article'),title=document.createElement('strong'),range=document.createElement('span'),rain=document.createElement('span');title.textContent=new Date(day+'T12:00:00').toLocaleDateString('pt-BR',{weekday:'short',day:'2-digit',month:'2-digit'});range.textContent=number(data.daily.temperature_2m_min[i])+' a '+number(data.daily.temperature_2m_max[i])+' °C';const probability=data.daily.precipitation_probability_max[i];rain.textContent=finite(probability)&&probability>=0&&probability<=100?'Chance de chuva: '+number(probability)+'%':'Chuva: não informada';article.append(title,range,rain);days.append(article);});
+  status((stale?'Exibindo última consulta salva. ':'Consulta atualizada. ')+'Horário da previsão: '+data.current.time.replace('T',' ')+' (horário local da cidade).');return true;
+ }
+ async function json(url){const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),8000);try{const response=await fetch(url,{signal:controller.signal,credentials:'omit',referrerPolicy:'no-referrer'});if(!response.ok)throw Error('Consulta indisponível');return await response.json();}finally{clearTimeout(timer);}}
+ async function load(force=false){
+  if(loading)return;const request=++sequence,location={...place},key='quiz-home-weather-cache-v1:'+location.latitude.toFixed(3)+':'+location.longitude.toFixed(3),cached=storage.read(key),now=Date.now();
+  if(!force&&cached&&Number.isFinite(cached.at)&&cached.at<=now&&now-cached.at<TTL&&paint(cached.data,cached.at,false))return;
+  if(cached)paint(cached.data,cached.at,true);
+  loading=true;lastAttempt=now;panel.setAttribute('aria-busy','true');find('[data-weather-refresh]').disabled=true;status('Atualizando a previsão de '+location.name+'…');
+  try{const url=new URL('https://api.open-meteo.com/v1/forecast');url.search=new URLSearchParams({latitude:location.latitude,longitude:location.longitude,current:'temperature_2m,weather_code',daily:'temperature_2m_min,temperature_2m_max,precipitation_probability_max',forecast_days:'3',timezone:'auto',temperature_unit:'celsius'}).toString();const data=await json(url);if(request!==sequence)return;if(!usable(data))throw Error('Dados incompletos');paint(data,now,false);storage.write(key,{at:now,data});}
+  catch{if(request!==sequence)return;if(!(cached&&paint(cached.data,cached.at,true))){find('[data-weather-title]').textContent='Previsão · '+place.name;find('[data-weather-summary]').textContent='Indisponível no momento';find('[data-weather-days]').replaceChildren();status('Não foi possível consultar o tempo. Tente Atualizar previsão quando estiver conectado.');}else status('Sem atualização agora. Dados salvos da previsão: '+cached.data.current.time.replace('T',' ')+'.');}
+  finally{if(request===sequence){loading=false;panel.setAttribute('aria-busy','false');find('[data-weather-refresh]').disabled=false;}}
+ }
+ find('[data-weather-refresh]').addEventListener('click',()=>load(true));
+ find('[data-weather-search]').addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget,query=form.elements.city.value.trim();if(query.length<3)return;const request=++searchSequence,button=form.querySelector('button');button.disabled=true;const results=find('[data-weather-results]');results.replaceChildren();status('Buscando cidade…');try{const url=new URL('https://geocoding-api.open-meteo.com/v1/search');url.search=new URLSearchParams({name:query,count:'5',language:'pt',countryCode:'BR'}).toString();const response=await json(url);if(request!==searchSequence)return;const rows=(Array.isArray(response.results)?response.results:[]).filter(row=>validPlace({...row,name:String(row.name||'')})).slice(0,5);if(!rows.length){status('Nenhuma cidade encontrada. Informe o nome completo.');return;}status('Escolha a cidade para consultar a previsão.');for(const row of rows){const name=[row.name,row.admin1,row.country].filter(x=>typeof x==='string'&&x).join(', ').slice(0,180),choice=document.createElement('button');choice.type='button';choice.textContent=name;choice.addEventListener('click',()=>{if(loading){status('Aguarde a consulta atual terminar e selecione a cidade novamente.');return;}place={name,latitude:row.latitude,longitude:row.longitude};storage.write('quiz-home-weather-place-v1',place);results.replaceChildren();find('[data-weather-days]').replaceChildren();find('[data-weather-title]').textContent='Previsão · '+name;find('[data-weather-summary]').textContent='Consultando…';load();});results.append(choice);}}
+  catch{if(request===searchSequence)status('Busca de cidade indisponível. Tente novamente em instantes.');}finally{if(request===searchSequence)button.disabled=false;}});
+ window.addEventListener('storage',event=>{if(event.key==='quiz-home-weather-place-v1'){const next=storage.read(event.key);if(validPlace(next)&&!loading){place=next;find('[data-weather-days]').replaceChildren();load();}}});
+ document.addEventListener('visibilitychange',()=>{if(!document.hidden&&Date.now()-lastAttempt>=TTL)load();});
+ load();
+})();
+
+  return true;
+}
+function iniciarResumoHome() {
+  if (montarResumoHome()) return;
+  const observer = new MutationObserver(() => { if (montarResumoHome()) observer.disconnect(); });
+  observer.observe(document.body, {childList:true, subtree:true});
+}
+if (document.readyState === "complete") setTimeout(iniciarResumoHome, 0);
+else window.addEventListener("load", iniciarResumoHome, {once:true});
+</script>
